<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Cable</RootNamespace>
        <EnvironmentName>Staging</EnvironmentName>
        <!-- The SDK's implicit default-item globbing (Content, etc.) would
             otherwise pick up wwwroot-admin's *.json/web.config files on its
             own, colliding with the explicit Content item below that covers
             the whole folder (including the .js/.css/.html files the
             implicit glob does NOT cover). -->
        <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot-admin\**;wwwroot-partner\**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.4" />
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="9.0.4">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Scalar.AspNetCore" Version="2.6.8" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Application\Application.csproj" />
      <ProjectReference Include="..\Cable.WebApi.OpenAPI\Cable.WebApi.OpenAPI.csproj" />
      <ProjectReference Include="..\Cable.WebApi\Cable.WebApi.csproj" />
      <ProjectReference Include="..\Infrastructrue\Infrastructrue.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Properties\PublishProfiles\SmaterASP.pubxml" />
      <None Remove="Properties\PublishProfiles\anashawas-001-site1 - FTP.pubxml" />
      <None Remove="Properties\PublishProfiles\Test.pubxml" />
    </ItemGroup>

    <!--
      wwwroot is auto-included by the Web SDK; wwwroot-admin (the Cable Admin
      SPA, synced by Scripts/build-admin.ps1) is a differently-named sibling
      folder and needs an explicit publish rule or it's silently left out of
      the publish output.
    -->
    <ItemGroup>
      <Content Include="wwwroot-admin\**" CopyToPublishDirectory="PreserveNewest" Exclude="wwwroot-admin\**\*.user" />
      <Content Include="wwwroot-partner\**" CopyToPublishDirectory="PreserveNewest" Exclude="wwwroot-partner\**\*.user" />
    </ItemGroup>

</Project>
